let slideTimer = null;
const subtitleDisplay = document.getElementById('subtitle-display');
let audioElements = [];
let subtitleElements = [];
let timedFragments = [];
const PAUSE_BEFORE_NEXT_SLIDE = 3000;
const pauseResumeBtn = document.getElementById('pause-resume-btn');
let currentAudioIndex = 0;
let isPaused = false;

function togglePauseResume() {
    isPaused = !isPaused;
    audio = audioElements[currentAudioIndex];
    
    if (isPaused) {
        audio.pause();
        pauseResumeBtn.textContent = '▶'; // Play icon
        pauseResumeBtn.setAttribute('aria-label', 'Resume');
    } else {
        audio.play().catch(() => {});
        pauseResumeBtn.textContent = '⏸'; // Pause icon
        pauseResumeBtn.setAttribute('aria-label', 'Pause');
    }
}


function startAudioForSlide(event) {
    const currentSlide = event.currentSlide;
    audioElements = currentSlide.querySelectorAll('.slide-audio');
    subtitleElements = currentSlide.querySelectorAll('.slide-subtitle');
    timedFragments = currentSlide.querySelectorAll('.timed-fragment');
    
    isPaused = false;

    // Show or hide pause button based on whether there's audio
    if (audioElements.length > 0) {
        // Reset button state
        pauseResumeBtn.textContent = '⏸';
        pauseResumeBtn.setAttribute('aria-label', 'Pause');
        pauseResumeBtn.style.display = 'inline-block';
    } else {
        pauseResumeBtn.style.display = 'none';
    }
    
    // Hide all timed fragments on all slides
    document.querySelectorAll('.timed-fragment').forEach(f => {
        f.classList.remove('visible');
    });
    
    // Hide subtitles
    subtitleDisplay.classList.remove('visible');
    subtitleDisplay.textContent = '';
    
    // If current slide has audio, schedule them based on audio-start
    if (audioElements.length > 0) {
        currentAudioIndex = 0;
        while (currentAudioIndex < audioElements.length) {
            const audio = audioElements[currentAudioIndex];
            const subtitle = subtitleElements[currentAudioIndex];
            subtitleDisplay.textContent = subtitle.textContent;
            const startTime = parseInt(audio.getAttribute('audio-start')) || 0;

            setTimeout(() => {
                audio.play().catch(() => {});
                subtitleDisplay.classList.add('visible');

                audio.onended = () => {
                    currentAudioIndex++
                };
            }, startTime);
        }

        setTimeout(() => {
            subtitleDisplay.classList.remove('visible');
            subtitleDisplay.textContent = '';
            Reveal.next();
        }, PAUSE_BEFORE_NEXT_SLIDE);
    }
    
    if (timedFragments.length > 0) {
        timedFragments.forEach(fragment => {
            const startTime = parseInt(fragment.getAttribute('fragment-start')) || 0;
            const duration = parseInt(fragment.getAttribute('fragment-duration')) || 3000;
            
            // Show fragment at start time
            setTimeout(() => {
                fragment.classList.add("visible");
            }, startTime);
        });
    }
}

// Pause/Resume button event listener
pauseResumeBtn.addEventListener('click', togglePauseResume);

// Fires on first load
// Reveal.on('ready', event => {
//     startAudioForSlide(event);
// });

// Fires when navigating
Reveal.on('slidechanged', event => {
    startAudioForSlide(event);
});

// Start button
document.getElementById("start-btn").addEventListener("click", () => {
    //Reveal.configure({ autoSlide: 5000 });
    Reveal.next();
});
